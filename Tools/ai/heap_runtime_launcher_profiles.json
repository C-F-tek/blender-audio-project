      "tool_catalog_limit": 80,
      "revision_context_mode": "auto_latest",
      "revision_context_max_tasks": 6,
      "universe_enabled": true,
      "universe_roles": ["gpu1_planner", "gpu0_reviewer_refiner", "npu_auditor"],
      "universe_max_steps": 2,
      "universe_stop_condition": "first_concrete_product_or_blocked_reason",
