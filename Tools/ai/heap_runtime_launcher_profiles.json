    "runtime": ["budget_minutes", "max_iterations", "max_provider_revisions", "timeout_seconds", "preflight_timeout_seconds", "allow_provider_generation"],
    "startup_context": ["startup_max_memory_chars", "startup_max_context_files", "startup_max_chars_per_file", "context_document_count", "context_document_preview_chars", "semantic_code_chunk_limit", "semantic_code_chunk_preview_chars", "semantic_evidence_chunk_limit", "memory_search_limit", "tool_catalog_limit"],
