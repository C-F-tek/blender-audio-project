      "skip_preflight": false,
      "skip_startup_reload": false,
      "strict_startup_reload": false,
      "no_documents": false,
      "request": "Run heap esterno DEEP: massimizza contesto preload repo/docs/memoria/tool, operational scratch memory, più revisioni GPU1/GPU0/NPU, consuma revision context precedente, usa block pointers persistenti per forward/backrefinement, forza proposal chunks concreti con repo-relative paths, rigetta ripetizioni e placeholder/stub, produci package finale di revisione operatore."
    },
    "strict_startup_external_heap": {
      "description": "Strict startup profile: preload degradation blocks the launcher before provider work.",
      "budget_minutes": 10,
      "max_iterations": 4,
      "max_provider_revisions": 3,
      "timeout_seconds": 1200,
      "preflight_timeout_seconds": 120,
