      "timeout_seconds": 600,
      "preflight_timeout_seconds": 90,
      "allow_provider_generation": true,
      "npu_device_workload_seconds": 3.0,
      "npu_device_workload_iterations": 2500,
      "startup_max_memory_chars": 32000,
      "startup_max_context_files": 48,
      "startup_max_chars_per_file": 8000,
      "context_document_count": 24,
      "context_document_preview_chars": 1200,
      "semantic_code_chunk_limit": 32,
