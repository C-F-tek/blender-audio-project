      "universe_enabled": true,
      "universe_roles": ["gpu1_planner", "gpu0_reviewer_refiner", "npu_auditor"],
      "universe_max_steps": 4,
      "universe_stop_condition": "strict_startup_then_concrete_product",
      "block_pointer_protocol": "external_heap_block_pointer_v1",
      "max_blocks_per_step": 6,
      "max_block_chars": 9000,
      "max_revision_depth": 4,
      "allow_backrefinement": true,
      "allow_forward_pointers": true,
      "require_resume_pointer": true,
      "require_refines_pointer": true,
      "skip_preflight": false,
      "skip_startup_reload": false,
      "strict_startup_reload": true,
      "no_documents": false,
      "request": "Run heap esterno STRICT STARTUP: fallisci se il preload context/memory/tool/docs degrada; se passa, esegui GPU1/GPU0/NPU, consuma revision context precedente se disponibile, usa block pointers e composer finale."
    },
    "dry_packaging_external_heap": {
      "description": "Packaging/debug profile: no provider generation, useful for checking preflight/startup/composer/block-pointer wiring.",
      "budget_minutes": 3,
      "max_iterations": 1,
      "max_provider_revisions": 1,
      "timeout_seconds": 300,
      "preflight_timeout_seconds": 90,
      "allow_provider_generation": false,
      "npu_device_workload_seconds": 1.0,
