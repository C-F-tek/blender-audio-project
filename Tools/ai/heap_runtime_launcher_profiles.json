      "universe_stop_condition": "accepted_concrete_product_or_exhausted_revision_depth_with_blocking_reason",
      "block_pointer_protocol": "external_heap_block_pointer_v1",
      "max_blocks_per_step": 12,
      "max_block_chars": 14000,
      "max_revision_depth": 8,
      "allow_backrefinement": true,
      "allow_forward_pointers": true,
      "require_resume_pointer": true,
